# ChatApp Backend — Environment Variables
# Copy this to .env and fill in your values

PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT secrets — use strong random strings in production
JWT_ACCESS_SECRET=chatapp-access-secret-dev-2024
JWT_REFRESH_SECRET=chatapp-refresh-secret-dev-2024

# Google OAuth — from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
